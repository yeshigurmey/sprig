// Prints every prime below a limit using trial division.
fn is_prime(n: int) -> bool {
    if n < 2 {
        return false;
    }
    let d = 2;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d = d + 1;
    }
    return true;
}

let limit = 50;
let n = 0;
let count = 0;
while n < limit {
    if is_prime(n) {
        print(n);
        count = count + 1;
    }
    n = n + 1;
}
print(count);
